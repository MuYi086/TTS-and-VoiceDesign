        "offset_ms": 0,
        "duration_seconds": 2.0,
        "mix_preset": "action_under_dialogue",
        "required": false
      }
    ]
  },
  {
    "type": "dialogue",
    "role_name": "旁白",
    "text_content": "前门打不开了。我尖叫着猛拉门把手。",
    "emotion": "fear",
    "intensity": "微弱",
    "clone_mode": "ultimate",
    "delivery_profile": "baseline",
    "voxcpm_nonverbal_tags": [],
    "needs_review": false,
    "break_duration": 0
  },
  {
    "type": "dialogue",
    "role_name": "旁白",
    "text_content": "她在逼近。",
    "emotion": "fear",
    "intensity": "微弱",
    "clone_mode": "ultimate",
    "delivery_profile": "baseline",
    "voxcpm_nonverbal_tags": [],
    "needs_review": false,
    "break_duration": 0.5
  },
  {
    "type": "dialogue",
    "role_name": "旁白",
    "text_content": "阁楼的梯子放下来了，我冲了上去。",
    "emotion": "fear",
    "intensity": "微弱",
    "clone_mode": "ultimate",
    "delivery_profile": "baseline",
    "voxcpm_nonverbal_tags": [],
    "needs_review": false,
    "break_duration": 0
  },
  {
    "type": "dialogue",
    "role_name": "旁白",
    "text_content": "我掏出手机，疯狂地想打开教授发给我的邮件。",
    "emotion": "fear",
    "intensity": "微弱",
    "clone_mode": "ultimate",
    "delivery_profile": "baseline",
    "voxcpm_nonverbal_tags": [],
    "needs_review": false,
    "break_duration": 0
  },
  {
    "type": "dialogue",
    "role_name": "旁白",
    "text_content": "透过阁楼口，布罗迪和那个火焰女人仰头盯着我。",
    "emotion": "fear",
    "intensity": "微弱",
    "clone_mode": "ultimate",
    "delivery_profile": "baseline",
    "voxcpm_nonverbal_tags": [],
    "needs_review": false,
    "break_duration": 0
  },
  {
    "type": "dialogue",
    "role_name": "旁白",
    "text_content": "门砰地关上了。",
    "emotion": "fear",
    "intensity": "微弱",
    "clone_mode": "ultimate",
    "delivery_profile": "baseline",
    "voxcpm_nonverbal_tags": [],
    "needs_review": false,
    "break_duration": 0,
