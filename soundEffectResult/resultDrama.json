        "required": false
      }
    ]
  },
  {
    "type": "dialogue",
    "role_name": "旁白",
    "text_content": "我跑了。",
    "emotion": "fear",
    "intensity": "微弱",
    "clone_mode": "ultimate",
    "delivery_profile": "baseline",
    "voxcpm_nonverbal_tags": [],
    "needs_review": false,
    "break_duration": 0
  },
  {
    "type": "dialogue",
    "role_name": "旁白",
    "text_content": "穿过房子时，门像枪声一样砰砰地关合。",
    "emotion": "fear",
    "intensity": "微弱",
    "clone_mode": "ultimate",
    "delivery_profile": "baseline",
    "voxcpm_nonverbal_tags": [],
    "needs_review": false,
    "break_duration": 0,
    "sfx_plan": [
      {
        "id": "sfx_doors_slam",
        "action": "generate",
        "purpose": "foreground_action",
        "sound_class": "门猛烈关合声",
        "prompt": "一连串木门被猛烈摔上的砰砰巨响，像枪声般短促有力，在室内空间产生回响，逐渐收尾",
