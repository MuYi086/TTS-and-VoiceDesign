        "required": false
      }
    ]
  },
  {
    "type": "dialogue",
    "role_name": "旁白",
    "text_content": "我一直等到夜幕降临，拿了藏着的钥匙，自己开了门。",
    "emotion": "coldness",
    "intensity": "中等",
    "clone_mode": "ultimate",
    "delivery_profile": "baseline",
    "voxcpm_nonverbal_tags": [],
    "needs_review": false,
    "break_duration": 0
  },
  {
    "type": "dialogue",
    "role_name": "旁白",
    "text_content": "房子里很安静，我蹑手蹑脚地穿过各个房间，寻找他。",
    "emotion": "fear",
    "intensity": "微弱",
    "clone_mode": "ultimate",
    "delivery_profile": "baseline",
    "voxcpm_nonverbal_tags": [],
    "needs_review": false,
    "break_duration": 0
  },
  {
    "type": "dialogue",
    "role_name": "旁白",
    "text_content": "当我偷偷望向他的卧室时，我倒吸一口凉气。",
    "emotion": "fear",
    "intensity": "微弱",
    "clone_mode": "ultimate",
    "delivery_profile": "baseline",
    "voxcpm_nonverbal_tags": [],
    "needs_review": false,
    "break_duration": 0
  },
  {
    "type": "dialogue",
    "role_name": "旁白",
    "text_content": "布罗迪趴伏在床上，盯着天花板。那个火焰女人坐在他身上。",
    "emotion": "fear",
    "intensity": "微弱",
    "clone_mode": "ultimate",
    "delivery_profile": "baseline",
    "voxcpm_nonverbal_tags": [],
    "needs_review": false,
    "break_duration": 0
  },
  {
    "type": "dialogue",
    "role_name": "旁白",
    "text_content": "她听到我的动静，猛地转过头来，嘶嘶作响，露出两英寸长的尖牙。",
    "emotion": "fear",
    "intensity": "微弱",
    "clone_mode": "ultimate",
    "delivery_profile": "baseline",
    "voxcpm_nonverbal_tags": [],
    "needs_review": false,
    "break_duration": 0,
    "sfx_plan": [
