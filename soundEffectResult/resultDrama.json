    "break_duration": 0
  },
  {
    "type": "dialogue",
    "role_name": "旁白",
    "text_content": "我一直念诵着导师发给我的经文，直到我的声音和手机电池都耗尽。",
    "emotion": "fear",
    "intensity": "微弱",
